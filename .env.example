# ==============================================================================
# AARIVA Environment Configuration (.env.example)
# ==============================================================================

# Server Network & Environment
PORT=4001
NODE_ENV=development

# JWT Authentication Secret (Must be at least 32 characters)
AUTH_SECRET=replace-with-a-random-secret-key-at-least-32-chars-long

# MongoDB Database Configuration
# Leave MONGODB_URI empty for the zero-config embedded in-memory MongoDB replica set.
# Or provide your MongoDB Atlas cluster URI or local mongod URI:
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI=mongodb://127.0.0.1:27017/aariva
MONGODB_URI=
MONGODB_DB=aariva

# Allowed Client Origins for CORS (comma-separated URLs)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Local demo data (set to 'false' to skip demo accounts and meals)
SEED_DEMO_DATA=true
DEFAULT_MEAL_PRICE_PAISE=5000

# Optional default location names for a new database
DEFAULT_MESS_NAME=The Garden Table
DEFAULT_INSTITUTION_NAME=AARIVA House

# ==============================================================================
# Frontend Optional Overrides (Vite)
# ==============================================================================
# Leave empty to use local Vite reverse proxy (/api -> http://127.0.0.1:4001)
VITE_API_BASE_URL=
