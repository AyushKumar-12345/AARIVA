{
  "name": "aariva",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A simple student dining and meal reservation app.",
  "scripts": {
    "dev": "concurrently -k \"npm:server:watch\" \"npm:client\"",
    "server:watch": "node --watch server/index.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
